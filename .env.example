# =================================================================
# MY WARDROBE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your real credentials:
#   cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# 0. AUTHENTICATION (REQUIRED)
# -----------------------------------------------------------------
# Single-user credentials. Set in GitHub Secrets (AUTH_USERNAME and AUTH_PASSWORD) for production.
AUTH_USERNAME=admin
AUTH_PASSWORD=change_this_to_a_secure_password

# Cryptographic session signing secret (REQUIRED, minimum 32 random characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change_this_to_at_least_32_characters_random_secret

# -----------------------------------------------------------------
# 1. DATABASE (PostgreSQL) - REQUIRED
# -----------------------------------------------------------------
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
# Local / Native Server: postgresql://wardrobe:your_secure_password@localhost:5432/wardrobe
# Docker Compose: postgresql://wardrobe:your_secure_password@db:5432/wardrobe
DATABASE_URL=postgresql://wardrobe:your_secure_password@localhost:5432/wardrobe
DB_USER=wardrobe
DB_PASSWORD=change_this_to_a_secure_password
DB_NAME=wardrobe

# -----------------------------------------------------------------
# 2. AI & VISION SERVICES (REQUIRED)
# -----------------------------------------------------------------
# Google AI Studio API Key - Text Models (Gemini 3.5 Flash-Lite detection, tagging & suggestions)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Google AI Studio Image Key (Used EXCLUSIVELY for Nano Banana image generation & virtual try-on; NEVER for detection or tagging)
GEMINI_IMAGE_API_KEY=your_paid_google_ai_studio_image_key_here

# Puter.js Auth Token(s) - Cloud Image Generation (Nano Banana)
# Single token:
PUTER_AUTH_TOKEN=your_puter_jwt_token_here
# Or multiple tokens for round-robin rotation pool (comma-separated):
# PUTER_AUTH_TOKENS="token1, token2, token3"

# Active Image Generation Engine: "puter" (default), "local", or "cloud"
IMAGE_GEN_ENGINE=puter

# -----------------------------------------------------------------
# 3. OPTIONAL EXTERNAL CLOUD SERVICES
# -----------------------------------------------------------------
# Cloudinary (CDN storage & AI generative background removal)
# Format: cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
# If omitted, local storage + local sharp background removal is used.
CLOUDINARY_URL=

# Hugging Face Access Token (for Leffa / IDM-VTON Spaces fallback)
# Obtain from: https://huggingface.co/settings/tokens
HF_TOKEN=

# -----------------------------------------------------------------
# 4. SERVER & STORAGE CONFIGURATION
# -----------------------------------------------------------------
# Local directory path where crops, originals, and cutouts are stored
STORAGE_PATH=./data

# Maximum payload size for photo uploads
BODY_SIZE_LIMIT=20M

# Virtual Try-On backend routing: "puter" (recommended), "local", or "hf-spaces"
TRYON_BACKEND=puter

# Optional GPU Local AI endpoints (if running dedicated RTX GPU worker)
LOCAL_AI_URL=http://localhost:8000
COMFYUI_URL=http://localhost:8188
# Directory on host containing ComfyUI models to mount into Docker
COMFYUI_MODELS_DIR=./models

# Optional comma-separated list of additional allowed CORS origins (for custom web/mobile clients)
# ALLOWED_ORIGINS=https://wardrobe.example.com

